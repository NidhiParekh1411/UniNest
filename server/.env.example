PORT=4000

# Signs every session. The fallback in lib/auth.js is published in this repo, so
# a production boot without this set is refused. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=change-me-in-production

# Set to production when deploying. Turns on the JWT_SECRET check and turns off
# the permissive development CORS policy.
NODE_ENV=

# Comma-separated origins allowed to call the API. Leave empty when Express
# serves the frontend itself — the app is then same-origin and needs no CORS.
CORS_ORIGIN=

# Where uploaded files are written. Leave empty for server/data/uploads. Point it
# at a mounted disk on a host whose filesystem is wiped between deploys.
UPLOAD_DIR=

# MongoDB. Atlas: copy the SRV string from Connect → Drivers and put the
# database password in it. Local mongod: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=college_rag

# Which store to use.
#   unset  — try MongoDB, fall back to the JSON files in server/data/ (default)
#   file   — always use the JSON files; never contact MongoDB
#   mongo  — require MongoDB; fail at startup if it is unreachable
# Leave it unset to run with no setup. Set it to mongo for a real deployment.
DB_DRIVER=

# answer composition. Set it to upgrade answer synthesis + question generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
